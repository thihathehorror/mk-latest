# Cursor indexing / AI-access exclusions — trc-central
# Mirrors the generated-output set in .gitignore. Source stays visible:
# src/, SiteAssets/, sharepoint/assets/, config/, scripts/, docs/, teams/

# Dependencies
node_modules/

# Build output — regenerated by `npm run build`
dist/
lib/
lib-dts/
lib-commonjs/
lib-esm/
release/
temp/
jest-output/
.heft/

# Generated SharePoint package output
# (sharepoint/assets/*.xml + png stay visible — tracked source)
sharepoint/solution/
**/*.sppkg

# Local index / caches
.codegraph/
*.tsbuildinfo

# Archives — unreadable to the model, extracted copies already present
*.zip

# Binary docs — no code-search value
*.docx
*.dotx
